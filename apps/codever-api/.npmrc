# Skip optional dependencies on install.
# keycloak-connect declares `chromedriver: latest` as an optionalDependency
# (used only by its own e2e tests, never at runtime). Omitting it keeps the
# large, vulnerable chromedriver subtree (basic-ftp, axios, form-data, …) out
# of local installs — matching the production image, which already builds with
# `npm ci --omit=dev --no-optional` (see Dockerfile).
omit=optional

