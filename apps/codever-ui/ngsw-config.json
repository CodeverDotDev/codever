{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-performance-v2",
      "urls": [
        "/api/public/users*",
        "/api/public/users/**",
        "/api/public/search-results*",
        "/api/public/search-results/**",
        "/api/public/feedback*",
        "/api/public/feedback/**",
        "/api/webpage-info*",
        "/api/webpage-info/**",
        "/api/version*",
        "/api/version/**",
        "/api/feature-toggle*",
        "/api/feature-toggle/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "3d"
      },
      "version": 2
    }
  ]
}
