{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/main-link-shortcut-spec",
    "typeRoots": ["../node_modules/@types", "../node_modules"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "app/core/shortcut/main-link-shortcut.service.spec.ts",
    "app/core/shortcut/main-link-shortcut.filters.spec.ts",
    "app/core/shortcut/resource-activation.util.spec.ts",
    "**/*.d.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
