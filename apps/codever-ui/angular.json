{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "codever-ui": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist"
            },
            "index": "src/index.html",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "assets": [
              "src/assets",
              "src/assets/favicon.ico",
              "src/manifest.json"
            ],
            "styles": [
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.scss",
              "./node_modules/highlight.js/styles/github-dark.css",
              "./node_modules/katex/dist/katex.min.css",
              "./node_modules/izitoast/dist/css/iziToast.min.css",
              //"./node_modules/@fortawesome/fontawesome-free/scss/fontawesome.scss",
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css"
            ],
            "scripts": [
              "./node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ],
            "allowedCommonJsDependencies": [
              "izitoast"
            ],
            "aot": false,
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "non-docker": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.non-docker.ts"
                }
              ]
            },
            "test": {
              "polyfills": [
                "core-js/es6/reflect",
                "core-js/es7/reflect",
                "zone.js",
                "zone.js/testing",
                "zone.js/plugins/vitest-patch"
              ]
            },
            "prod-local-testing": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod-backend.local-testing.ts"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "codever-ui:build",
            "host": "0.0.0.0"
          },
          "configurations": {
            "production": {
              "buildTarget": "codever-ui:build:production"
            },
            "non-docker": {
              "buildTarget": "codever-ui:build:non-docker"
            },
            "prod-backend": {
              "buildTarget": "codever-ui:build:prod-local-testing"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "codever-ui:build"
          }
        },
        "test-onpush": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "codever-ui:build:test",
            "runner": "vitest",
            "tsConfig": "src/tsconfig.onpush-spec.json",
            "include": ["src/app/shared/onpush-lists.spec.ts"],
            "watch": false
          }
        },
        "test-copyable": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "codever-ui:build:test",
            "runner": "vitest",
            "tsConfig": "src/tsconfig.copyable-spec.json",
            "include": [
              "src/app/shared/copyable-fields/*.spec.ts",
              "src/app/shared/onpush-lists.spec.ts"
            ],
            "watch": false
          }
        },
        "test-shortcuts": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "codever-ui:build:test",
            "runner": "vitest",
            "tsConfig": "src/tsconfig.shortcuts-spec.json",
            "include": ["src/app/app.component.shortcuts.spec.ts"],
            "watch": false
          }
        },
        "test-main-link-shortcut": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "codever-ui:build:test",
            "runner": "vitest",
            "tsConfig": "src/tsconfig.main-link-shortcut-spec.json",
            "include": [
              "src/app/core/shortcut/main-link-shortcut.service.spec.ts",
              "src/app/core/shortcut/main-link-shortcut.filters.spec.ts",
              "src/app/core/shortcut/resource-activation.util.spec.ts"
            ],
            "watch": false
          }
        },
        "test-collection-contents": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "codever-ui:build:test",
            "runner": "vitest",
            "tsConfig": "src/tsconfig.collection-contents-spec.json",
            "include": [
              "src/app/shared/dialog/collection-contents-dialog/*.spec.ts"
            ],
            "watch": false
          }
        },
        "test-my-collections": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "codever-ui:build:test",
            "runner": "vitest",
            "tsConfig": "src/tsconfig.my-collections-spec.json",
            "include": ["src/app/my-collections/**/*.spec.ts"],
            "watch": false
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "codever-ui:build:test",
            "runner": "vitest",
            "tsConfig": "src/tsconfig.spec.json",
            "include": ["src/**/*.spec.ts"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
